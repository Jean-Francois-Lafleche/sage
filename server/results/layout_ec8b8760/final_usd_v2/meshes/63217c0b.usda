            asset inputs:file = @../textures/63217c0b_texture.png@
            float2 inputs:st.connect = <../PrimvarReader.outputs:result>
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "repeat"
            float3 outputs:rgb
