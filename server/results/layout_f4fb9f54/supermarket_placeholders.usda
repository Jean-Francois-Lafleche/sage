#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Cube "Floor"
    {
        rel material:binding = </World/Floor_mat>
        double size = 1
        float3 xformOp:scale = (3, 15, 0.1)
        double3 xformOp:translate = (1.5, 7.5, -0.05)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Material "Floor_mat"
    {
        token outputs:surface.connect = </World/Floor_mat/Shader.outputs:surface>

        def Shader "Shader"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.55, 0.35, 0.17)
