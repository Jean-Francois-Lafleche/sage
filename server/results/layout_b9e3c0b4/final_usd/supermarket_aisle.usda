{
    def "Room"
    {
        def Cube "Floor"
        {
            rel material:binding = </World/Room/Floor_mat>
            double size = 1
            float3 xformOp:scale = (3, 15, 0.1)
            double3 xformOp:translate = (1.5, 7.5, -0.05)
