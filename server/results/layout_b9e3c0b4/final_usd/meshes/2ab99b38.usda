    def Material "Material"
    {
        token outputs:surface.connect = </Mesh/Material/PBR.outputs:surface>

        def Shader "PBR"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor.connect = </Mesh/Material/DiffuseTex.outputs:rgb>
