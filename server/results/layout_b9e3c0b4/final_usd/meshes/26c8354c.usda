        }

        def Shader "DiffuseTex"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @../textures/26c8354c_texture.png@
            float2 inputs:st.connect = </Mesh/Material/STReader.outputs:result>
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "repeat"
