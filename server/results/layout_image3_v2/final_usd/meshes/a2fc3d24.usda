            asset inputs:file = @../textures/a2fc3d24_texture.png@
            float2 inputs:st.connect = <../PrimvarReader.outputs:result>
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "repeat"
            float3 outputs:rgb
